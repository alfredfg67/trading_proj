# SQLAlchemy async connection string.
# SQLite (default, no setup required):
DATABASE_URL=sqlite+aiosqlite:///./trading.db
# Or Postgres (matches docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://trading_user:trading_pass@localhost:5432/trading_db

# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Chat/channel ID to receive trade alerts. Optional — if omitted, notifications are skipped.
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
